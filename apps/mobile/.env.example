# Mobile App Environment Variables
# Copy to .env (gitignored) and fill in values

# ── API ───────────────────────────────────────────────────────────────────────
# Your server URL. In development, use your local machine IP or ngrok tunnel.
# Do NOT use localhost on a physical device.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/api/v1
EXPO_PUBLIC_WS_URL=http://192.168.1.100:3000

# ── Maps ──────────────────────────────────────────────────────────────────────
# Google Maps API key — required on Android for react-native-maps.
# Get a key from: https://console.cloud.google.com/
# Enable: Maps SDK for Android, Maps SDK for iOS
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=CHANGE_ME_GOOGLE_MAPS_API_KEY

# ── Notifications ─────────────────────────────────────────────────────────────
# EAS Project ID from: eas init
# Used for push notifications via Expo Push Notification Service
EXPO_PUBLIC_EAS_PROJECT_ID=REPLACE_WITH_EAS_PROJECT_ID

# ─── Server Environment Variables ──────────────────────────────────────────────
# Copy to .env and fill in values. Never commit .env.

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# Used for the main application connection
DATABASE_URL=postgresql://runalive:runalive_dev@localhost:5432/runalive
# Used for migrations (same DB, can use admin credentials in CI)
DATABASE_URL_MIGRATE=postgresql://runalive:runalive_dev@localhost:5432/runalive
# Used for tests (separate database)
DATABASE_URL_TEST=postgresql://runalive:runalive_test@localhost:5432/runalive_test

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Use: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars_long_here
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars_long_here
# Token TTLs
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (mobile uses capacitor/exp schemes)
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Mailpit for development: docker compose up -d
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@runalive.app
# For production: use SendGrid, SES, Postmark, etc.

# ── File Storage ──────────────────────────────────────────────────────────────
# STORAGE_ADAPTER: 'local' or 's3'
STORAGE_ADAPTER=local
# Local storage path (relative to server root)
LOCAL_UPLOAD_DIR=./uploads

# S3-compatible (set STORAGE_ADAPTER=s3 to use)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=runalive-uploads
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# S3_PUBLIC_URL=https://cdn.runalive.app

# ── App URLs ──────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
DEEP_LINK_SCHEME=runalive

# ── Rate Limits ───────────────────────────────────────────────────────────────
# Requests per window
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_JOIN_WINDOW_MS=60000
RATE_LIMIT_JOIN_MAX=10
RATE_LIMIT_LOCATION_WINDOW_MS=10000
RATE_LIMIT_LOCATION_MAX=5
